{
  "name": "pixavelo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config=playwright.live.config.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:hardening": "node scripts/hardening-audit.mjs",
    "audit:operations": "node scripts/operational-audit.mjs",
    "release:artifacts": "node scripts/create-release-evidence.mjs",
    "release:clean": "node scripts/assert-clean-release.mjs",
    "release:check": "npm run check && npm run audit:hardening && npm run audit:operations && npm run audit:production && npm run test:e2e",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "rollback:pages": "node scripts/rollback-pages.mjs",
    "rollback:rehearse": "node scripts/rehearse-rollback.mjs",
    "observe:slo": "node scripts/record-slo-observation.mjs",
    "report:slo": "node scripts/report-slo.mjs",
    "certify:device": "node scripts/device-certification.mjs",
    "escalate:operations:dry-run": "node scripts/escalate-operational-failure.mjs --dry-run",
    "predeploy:pages": "npm run release:clean && npm run release:check && npm run release:artifacts",
    "deploy:pages": "wrangler pages deploy dist --project-name pixavelo --branch main --commit-dirty=false",
    "postdeploy:pages": "npm run verify:deployment",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@discourse/heic": "^1.0.0",
    "@jsquash/avif": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
